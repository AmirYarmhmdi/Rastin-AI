# File guide.
# Use: Keeps local-only files out of Docker build contexts.
# Usage: Docker reads this file automatically during image builds.
# Duties: Excludes caches, virtualenvs, data folders, tests, and docs.
# Depends on: Dockerfile build behavior.

.git
.github
.venv
__pycache__/
*.py[cod]
*.pyo

.env
.env.*
!.env.example

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

.vscode/
.idea/
*.swp
*.swo
.DS_Store

build/
dist/
*.egg-info/

storage/
qdrant_storage/
postgres_data/
langfuse_data/
rastin_ai_*_data/
rastin_ai_*_logs/

tests/
docs/
