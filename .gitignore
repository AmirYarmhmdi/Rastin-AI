# File guide.
# Use: Keeps local generated files out of git.
# Usage: Git reads this file when showing status and staging changes.
# Duties: Ignores caches, environments, build output, and local data.
# Depends on: The project tools that create those local files.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.sved
.hypothesis/
.pytest_cache/
cover/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# IDEs, Editors and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Runtime uploads
/storage/

# Evaluation outputs
/evaluation-results/

# Local codebase knowledge graph generated by graphify
/graphify-out/

# Future planning/development notes
/future_developments/

# Frontend dependencies and build artifacts
node_modules/
apps/*/node_modules/
*.tsbuildinfo
apps/*/dist/
apps/*/.vite/
AGENTS.md